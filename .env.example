# Copy to backend/.env and fill in. The process refuses to start if anything
# here is missing or malformed, rather than failing on the first request that
# needs it.

NODE_ENV=development
PORT=4000

# Postgres. For local development, backend/db/tests/run.sh explains how to
# start a scratch instance.
DATABASE_URL=postgres://postgres@/attest?host=/tmp/attest-pg&port=55432
DATABASE_POOL_MAX=10

# Token signing. Generate with:  openssl rand -base64 48
# These MUST be different from each other: if they match, a refresh token is
# accepted as an access token and the short access lifetime means nothing.
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# Where encrypted documents are written. Never commit this directory.
STORAGE_ROOT=uploads

# Document encryption, 32 bytes base64:  openssl rand -base64 32
# REQUIRED in production. In development it is derived from JWT_ACCESS_SECRET so
# the API and the worker agree without extra setup — but never reuse a signing
# secret as an encryption key in a real deployment: rotating one would make
# every stored document unreadable.
# STORAGE_ENCRYPTION_KEY=

# Signs the short-lived links that open a source document. Separate from the
# token secrets so rotating one does not invalidate the other.
# STORAGE_SIGNING_SECRET=

# AI invoice extraction. Optional: without it every other part of Attest works,
# and an uploaded invoice fails with a message saying exactly that. Get a key at
# console.anthropic.com — new accounts come with trial credit.
# ANTHROPIC_API_KEY=

# Points the SDK at a different host. Used by the integration tests to run the
# real client against a local server. Leave unset in any real deployment.
# ANTHROPIC_BASE_URL=

# STORAGE_BUCKET=attest-documents
