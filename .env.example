# Copy to backend/.env and fill in. The process refuses to start if anything
# here is missing or malformed, rather than failing on the first request that
# needs it.

NODE_ENV=development
PORT=4000

# Postgres. For local development, backend/db/tests/run.sh explains how to
# start a scratch instance.
DATABASE_URL=postgres://postgres@/attest?host=/tmp/attest-pg&port=55432
DATABASE_POOL_MAX=10

# Token signing. Generate with:  openssl rand -base64 48
# These MUST be different from each other: if they match, a refresh token is
# accepted as an access token and the short access lifetime means nothing.
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# Optional until storage and extraction are wired up.
# STORAGE_BUCKET=attest-documents
# ANTHROPIC_API_KEY=
