{
  "name": "attest-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Attest API — document pipeline, deterministic tax engine, review workflow.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "lint": "eslint src tests",
    "test:db": "bash db/tests/run.sh",
    "test:all": "npm run test && npm run test:db",
    "worker": "node src/workers/index.js",
    "worker:dev": "node --watch src/workers/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "nepali-date-converter": "^3.4.0",
    "nepali-datetime": "^2.0.0"
  }
}
